# Alpaca API Credentials (Required - Keep Secret!)
APCA_API_KEY_ID=your_key_here
APCA_API_SECRET_KEY=your_secret_here

# Disable Python bytecode cache (optional, recommended)
PYTHONDONTWRITEBYTECODE=1

# Note: All other configuration is now in src/env.json
# You can override any setting from env.json by adding it here
